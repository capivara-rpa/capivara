# ============================================================
#  Configurações do template - copie este arquivo para ".env"
#  e preencha com os seus valores.
# ============================================================

# Ambiente de execução: dev (com janela) | prod (headless)
AMBIENTE=dev

# Forçar modo headless (sem janela) - úteis em servidores/Docker
HEADLESS=false

# Tempo (em segundos) de espera padrão entre ações do navegador
TEMPO_ESPERA_PADRAO=5

# Tempo máximo (em segundos) que aguardamos um elemento aparecer
TEMPO_TIMEOUT=15

# URL que os robôs de exemplo utilizam
SITE_DEMO=https://www.google.com.br/

# ---- Credenciais de exemplo (NUNCA commitar valores reais) ----
USUARIO=
SENHA=

# ---- API ----
API_BASE_URL=
API_TOKEN=

# ---- E-mail (SMTP) ----
SMTP_SERVIDOR=
SMTP_PORTA=465
SMTP_USUARIO=
SMTP_SENHA=
SMTP_ORIGEM=

# ---- Nome do arquivo de log ----
NOME_LOG=rpa.log

# ---- Monitor / Control Room (painéis web locais) ----
# Porta dos painéis (Control Room fica em / e o trace em /monitor/)
PORTA_CONTROL_ROOM=8765
PORTA_MONITOR=8765
# Host/interface: 127.0.0.1 = só esta máquina; 0.0.0.0 = aceita runners da rede
HOST_CONTROL_ROOM=127.0.0.1
HOST_MONITOR=127.0.0.1
# Abrir o navegador sozinho ao subir o painel
ABRIR_PAINEL=true
# Segundos sem heartbeat até marcar a máquina como offline
SEGUNDOS_OFFLINE=20
# Intervalo (segundos) da checagem de agendamentos (triggers)
INTERVALO_TRIGGERS=15

# ---- Vault / Control Room como cliente ----
# URL da Control Room que os robôs consultam (assets/filas)
CONTROL_ROOM_URL=http://127.0.0.1:8765
# Token dos agentes (Authorization: Bearer). Vazio = Control Room aberta (dev/LAN).
# Em produção, defina o MESMO valor no servidor e em todos os agentes.
CONTROL_ROOM_TOKEN=
# TLS (HTTPS) opcional: caminhos do certificado e da chave em PEM. Vazio = HTTP.
# TLS_CERT=/caminho/cert.pem
# TLS_CHAVE=/caminho/key.pem
# Frase secreta que cifra os assets (vault). Vazio = usa data/vault.key local
VAULT_CHAVE=troque-esta-frase-para-cifrar-os-assets
# Guardar a chave do cofre no chaveiro do sistema (Keychain/Credential Manager)
# em vez de data/vault.key. Requer: pip install -e ".[keyring]". Ignorado se VAULT_CHAVE definido.
# VAULT_USAR_KEYRING=true
# Pasta onde robôs .zip instalados são guardados (default: app/robos)
# PASTA_ROBOS=
# Em binários instalados (PyInstaller), pasta de dados persistente
# RPA_PASTA_DADOS=/caminho/para/dados
# Robôs com requirements.txt ganham um .venv próprio (cria venv, atualiza pip,
# instala e roda). Desligue com false para usar o ambiente do agente.
# RPA_INSTALAR_DEPENDENCIAS=true

# ---- Login da Control Room (usuários locais no SQLite) ----
# Exigir login no painel (true) ou deixar aberto (false, dev/LAN)
CONTROL_ROOM_AUTH=false
# Admin criado automaticamente no primeiro start (troque depois pelo painel)
ADMIN_EMAIL=admin@rpa.local
ADMIN_SENHA=admin
# Validade da sessão (horas)
SESSAO_HORAS=12

# ---- Governança ----
# Dias de retenção da auditoria (expurgo automático ~1x/hora)
RETENCAO_AUDITORIA_DIAS=90
# Tempo limite (segundos) de um job antes de gerar alerta de SLA
LIMITE_JOB_SEGUNDOS=300